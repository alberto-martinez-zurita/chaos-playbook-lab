# =============================================================================
# Chaos Playbook Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
# =============================================================================

# --- LLM Providers (only needed for --with-llm) ---

# ZhipuAI GLM 4.5 (primary LLM provider)
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
ZHIPUAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# OpenAI (alternative provider, optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Local model (Ollama, LMStudio, etc. — optional)
# LOCAL_API_KEY=not-needed
# LOCAL_BASE_URL=http://localhost:1234/v1

# --- Legacy (optional, only for PetstoreAgent with Google ADK) ---
# GOOGLE_API_KEY=your_google_api_key_here

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Grafana (override defaults for production) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
